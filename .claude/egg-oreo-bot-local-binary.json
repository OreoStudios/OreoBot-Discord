                                         "script":  "#!/bin/bash\nset -euo pipefail\n\nmkdir -p /mnt/server\ncd /mnt/server\n\nexport DEBIAN_FRONTEND=noninteractive\napt-get update\napt-get install -y --no-install-recommends ca-certificates curl python3\n\nif [ \"${INSTALL_FFMPEG:-true}\" = \"true\" ]; then\n  apt-get install -y --no-install-recommends ffmpeg\nfi\n\napt-get clean\nrm -rf /var/lib/apt/lists/*\n\nRAW_BASE=\"https://raw.githubusercontent.com/${REPO_OWNER}/${REPO_NAME}/${BRANCH}\"\n\ncurl -L --fail --retry 3 --max-time 600 -o \"./config.json\" \"${RAW_BASE}/${CONFIG_FILE}\"\n\ncurl -L --fail --retry 3 --max-time 600 -o \"./lang.yml\" \"${RAW_BASE}/lang.yml\"\n\nif [ \"${INSTALL_YTDLP:-true}\" = \"true\" ]; then\n  curl -L --fail --retry 3 -o ./yt-dlp https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp\n  chmod +x ./yt-dlp\nfi\n\necho \"[INFO] Installation complete.\"\nls -lah",
